# D.O. - environment template. Copy to .env and fill in only what you intend to use.
# Nothing here is required: the seed boots with zero credentials and zero dependencies.
# D.O. reads credential VALUES only at the moment of a call. It never stores, logs,
# or writes them to memory. Variable NAMES are visible to it as world referents.

# --- cognition core -------------------------------------------------------
# reflex = no model, fully offline, reproducible (default, and the control condition)
# llm    = a model realizes the utterance plan D.O. already selected
DO_COGNITION__CORE=reflex

# provider for the llm core: ollama | groq | gemini | openai | anthropic
DO_COGNITION__LLM__PROVIDER=ollama
DO_COGNITION__LLM__ENDPOINT=http://localhost:11434
# leave MODEL empty to auto-select the smallest local model that fits measured free RAM
DO_COGNITION__LLM__MODEL=

# --- remote providers (only read when the matching provider is selected) --
# Keep real keys OUTSIDE this repo. ~/.do-secrets.env is a good home:
#   set -a && . ~/.do-secrets.env && set +a && do boot --core llm --provider groq
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- voice (optional; TTS is a peripheral, never part of cognition) -------
# ELEVENLABS_API_KEY=

# --- safety ---------------------------------------------------------------
# Set to 1 to hard-stop the organism. Equivalent to `do kill`.
# DO_KILL=0
